# Copy this file to .env and fill in the values. .env is not committed to git.
# Vite reads these when you run `npm run dev` or `npm run build` (a change needs a restart / rebuild).

# Required: address of reftech_core (no trailing slash).
VITE_API_URL=http://localhost:8080

# Optional: Google Maps for Live Tracking ("Maps JavaScript API" enabled). Empty = OpenStreetMap, no key needed.
VITE_GOOGLE_MAPS_API_KEY=
# Optional: key for the Google Maps Embed API on the trip detail page. Empty = keyless embed.
VITE_GOOGLE_MAPS_EMBED_KEY=
# Optional: set to osm to always use OpenStreetMap, even when a Google key is set.
VITE_MAP_PROVIDER=
# Optional: your own map tile server, e.g. https://tiles.example.com/{z}/{x}/{y}.png (default: public OpenStreetMap).
VITE_OSM_TILE_URL=
