# Docker Compose deployment settings
IMAGE_TAG=latest
FRONTEND_PORT=8081

# The backend as reached from inside the frontend container.
# host.docker.internal is mapped to the Linux Docker host by docker-compose.yml.
API_UPSTREAM=http://host.docker.internal:8080

# Leave empty when public Nginx exposes frontend and /api on the same domain.
VITE_API_URL=

# Optional map configuration. Vite values are compiled into the image.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_EMBED_KEY=
VITE_MAP_PROVIDER=osm
VITE_OSM_TILE_URL=